 /* wallust template - colors-rofi */

* {
active-background: #564E55;
active-foreground: #DEC7D4;
normal-background: #151315;
normal-foreground: #DEC7D4;
urgent-background: #906E81;
urgent-foreground: #DEC7D4;

alternate-active-background: #4F4A50;
alternate-active-foreground: #DEC7D4;
alternate-normal-background: #151315;
alternate-normal-foreground: #DEC7D4;
alternate-urgent-background: #151315;
alternate-urgent-foreground: #DEC7D4;

selected-active-background: #564E55;
selected-active-foreground: #151315;
selected-normal-background: #564E55;
selected-normal-foreground: #151315;
selected-urgent-background: #4F4A50;
selected-urgent-foreground: #151315;

background-color: #151315;
background: rgba(0,0,0,0.7);
foreground: #DEC7D4;
border-color: #564E55;

color0: #3F3E40;
color1: #4F4A50;
color2: #4F4A50;
color3: #4F4A50;
color4: #564E55;
color5: #906E81;
color6: #AB708F;
color7: #C8A7B9;
color8: #8C7581;
