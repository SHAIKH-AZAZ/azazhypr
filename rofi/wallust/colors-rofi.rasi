 /* wallust template - colors-rofi */

* {
active-background: #7B7E77;
active-foreground: #EAEDE6;
normal-background: #000000;
normal-foreground: #EAEDE6;
urgent-background: #B2BAAA;
urgent-foreground: #EAEDE6;

alternate-active-background: #707A6D;
alternate-active-foreground: #EAEDE6;
alternate-normal-background: #000000;
alternate-normal-foreground: #EAEDE6;
alternate-urgent-background: #000000;
alternate-urgent-foreground: #EAEDE6;

selected-active-background: #7B7E77;
selected-active-foreground: #000000;
selected-normal-background: #7B7E77;
selected-normal-foreground: #000000;
selected-urgent-background: #707A6D;
selected-urgent-foreground: #000000;

background-color: #000000;
background: rgba(0,0,0,0.7);
foreground: #EAEDE6;
border-color: #7B7E77;

color0: #000001;
color1: #93746C;
color2: #9166A2;
color3: #707A6D;
color4: #7B7E77;
color5: #B2BAAA;
color6: #C2CBB8;
color7: #D8DDD3;
color8: #979A94;
color9: #93746C;
color10: #9166A2;
color11: #707A6D;
color12: #7B7E77;
color13: #B2BAAA;
color14: #C2CBB8;
color15: #D8DDD3;


}

