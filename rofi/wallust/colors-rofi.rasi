 /* wallust template - colors-rofi */

* {
active-background: #666A69;
active-foreground: #D0D4D8;
normal-background: #1E1E1F;
normal-foreground: #D0D4D8;
urgent-background: #838890;
urgent-foreground: #D0D4D8;

alternate-active-background: #5A595C;
alternate-active-foreground: #D0D4D8;
alternate-normal-background: #1E1E1F;
alternate-normal-foreground: #D0D4D8;
alternate-urgent-background: #1E1E1F;
alternate-urgent-foreground: #D0D4D8;

selected-active-background: #666A69;
selected-active-foreground: #1E1E1F;
selected-normal-background: #666A69;
selected-normal-foreground: #1E1E1F;
selected-urgent-background: #5A595C;
selected-urgent-foreground: #1E1E1F;

background-color: #1E1E1F;
background: rgba(0,0,0,0.7);
foreground: #D0D4D8;
border-color: #666A69;

color0: #49494A;
color1: #565557;
color2: #575658;
color3: #5A595C;
color4: #666A69;
color5: #838890;
color6: #808A96;
color7: #B4B9C0;
color8: #7E8286;
