 /* wallust template - colors-rofi */

* {
active-background: #ABD5BB;
active-foreground: #E2F0E7;
normal-background: #000006;
normal-foreground: #E2F0E7;
urgent-background: #ABD5BB;
urgent-foreground: #E2F0E7;

alternate-active-background: #ABD5BB;
alternate-active-foreground: #E2F0E7;
alternate-normal-background: #000006;
alternate-normal-foreground: #E2F0E7;
alternate-urgent-background: #000006;
alternate-urgent-foreground: #E2F0E7;

selected-active-background: #ABD5BB;
selected-active-foreground: #000006;
selected-normal-background: #ABD5BB;
selected-normal-foreground: #000006;
selected-urgent-background: #ABD5BB;
selected-urgent-foreground: #000006;

background-color: #000006;
background: rgba(0,0,0,0.7);
foreground: #E2F0E7;
border-color: #ABD5BB;

color0: #151519;
