 /* wallust template - colors-rofi */

* {
active-background: #7C89A7;
active-foreground: #EEEDF3;
normal-background: #1F1F20;
normal-foreground: #EEEDF3;
urgent-background: #C36F84;
urgent-foreground: #EEEDF3;

alternate-active-background: #7E7D67;
alternate-active-foreground: #EEEDF3;
alternate-normal-background: #1F1F20;
alternate-normal-foreground: #EEEDF3;
alternate-urgent-background: #1F1F20;
alternate-urgent-foreground: #EEEDF3;

selected-active-background: #7C89A7;
selected-active-foreground: #1F1F20;
selected-normal-background: #7C89A7;
selected-normal-foreground: #1F1F20;
selected-urgent-background: #7E7D67;
