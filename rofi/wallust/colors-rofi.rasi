 /* wallust template - colors-rofi */

* {
active-background: #DBA391;
active-foreground: #E9EAC8;
normal-background: #060006;
normal-foreground: #E9EAC8;
urgent-background: #A0BCE8;
urgent-foreground: #E9EAC8;

alternate-active-background: #D87297;
alternate-active-foreground: #E9EAC8;
alternate-normal-background: #060006;
alternate-normal-foreground: #E9EAC8;
alternate-urgent-background: #060006;
alternate-urgent-foreground: #E9EAC8;

selected-active-background: #DBA391;
selected-active-foreground: #060006;
selected-normal-background: #DBA391;
selected-normal-foreground: #060006;
selected-urgent-background: #D87297;
selected-urgent-foreground: #060006;

background-color: #060006;
background: rgba(0,0,0,0.7);
foreground: #E9EAC8;
border-color: #DBA391;

color0: #0C030C;
color1: #826B84;
color2: #727F5E;
color3: #D87297;
color4: #DBA391;
color5: #A0BCE8;
color6: #C0C263;
color7: #D7D8A9;
color8: #969776;
color9: #826B84;
