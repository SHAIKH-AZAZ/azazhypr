 /* wallust template - colors-rofi */

* {
active-background: #B8E3F2;
active-foreground: #EAF6FA;
normal-background: #00000C;
normal-foreground: #EAF6FA;
urgent-background: #C3E6F2;
urgent-foreground: #EAF6FA;

alternate-active-background: #317CAF;
alternate-active-foreground: #EAF6FA;
alternate-normal-background: #00000C;
alternate-normal-foreground: #EAF6FA;
alternate-urgent-background: #00000C;
alternate-urgent-foreground: #EAF6FA;

selected-active-background: #B8E3F2;
selected-active-foreground: #00000C;
selected-normal-background: #B8E3F2;
selected-normal-foreground: #00000C;
selected-urgent-background: #317CAF;
selected-urgent-foreground: #00000C;

background-color: #00000C;
background: rgba(0,0,0,0.7);
foreground: #EAF6FA;
border-color: #B8E3F2;

color0: #00000E;
color1: #416586;
color2: #317BAE;
color3: #317CAF;
color4: #B8E3F2;
color5: #C3E6F2;
color6: #C3E6F2;
color7: #D9EAF0;
color8: #98A4A8;
color9: #416586;
color10: #317BAE;
color11: #317CAF;
color12: #B8E3F2;
color13: #C3E6F2;
color14: #C3E6F2;
color15: #D9EAF0;


}

